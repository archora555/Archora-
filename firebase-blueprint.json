{
  "entities": {
    "product": {
      "title": "Product",
      "description": "A furniture product in the catalog.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "modelUrl": { "type": "string" },
        "dimensions": { "type": "string" },
        "colors": { "type": "array", "items": { "type": "string" } },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "description", "price", "category", "images", "inStock", "stockCount", "createdAt", "updatedAt"]
    },
    "category": {
      "title": "Category",
      "description": "A product category.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "createdAt", "updatedAt"]
    },
    "order": {
      "title": "Order",
      "description": "A customer order.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "shippingAddress": { "type": "object" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "status", "items", "total", "createdAt", "updatedAt"]
    },
    "user": {
      "title": "User",
      "description": "User profile with role management.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["email", "role", "createdAt", "updatedAt"]
    },
    "admin": {
      "title": "Admin",
      "description": "An admin record.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "createdAt"]
    },
    "quote": {
      "title": "Quote",
      "description": "A customer quote request.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "size": { "type": "string" },
        "color": { "type": "string" },
        "material": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "review": {
      "title": "Review",
      "description": "A product review.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "coupon": {
      "title": "Coupon",
      "description": "A promotional discount coupon.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "type": { "type": "string" },
        "value": { "type": "number" },
        "expiryDate": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "settings": {
      "title": "Settings",
      "description": "Frontend configuration and layout settings.",
      "type": "object",
      "properties": {
        "heroBanners": { "type": "array" },
        "subCategories": { "type": "array" },
        "homeSections": { "type": "array" },
        "logoConfig": { "type": "object" },
        "menuItems": { "type": "array" },
        "layoutConfig": { "type": "object" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/product" },
      "description": "Collection of products"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/category" },
      "description": "Collection of categories"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/order" },
      "description": "Customer orders"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "User profiles"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/admin" },
      "description": "Admin privileges marker collection"
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/quote" },
      "description": "Customer quote requests"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/review" },
      "description": "Product customer reviews"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/coupon" },
      "description": "Discount coupons"
    },
    "/settings/{docId}": {
      "schema": { "$ref": "#/entities/settings" },
      "description": "Site and layout configuration"
    }
  }
}
